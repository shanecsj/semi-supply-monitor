# Copy this file to .env and fill in your key(s).
#   cp .env.example .env
#
# .env is gitignored. Never commit it.
# A real environment variable always overrides what is set here.

# ---------------------------------------------------------------- required-ish
# OpenCode Go - drives BOTH the digest classifier and the chat.
# Subscribe at https://opencode.ai/go ($10/month), then paste the key here.
OPENCODE_API_KEY=

# SEC EDGAR requires a contact address in the User-Agent or it returns 403.
SEMIMON_CONTACT=you@example.com

# ------------------------------------------------------------------- optional
# Model for classification and chat. See `semimon.cli chat --list-models`.
# glm-5.3 is the default; deepseek-v4-flash has a higher request quota,
# deepseek-v4-pro and kimi-k3 are stronger on harder questions.
SEMIMON_CHAT_MODEL=deepseek-v4-flash

# Force a provider: opencode | anthropic | heuristic. Default auto-detects.
# SEMIMON_CLASSIFIER=opencode

# Only needed if you want the Anthropic backend instead of OpenCode.
# ANTHROPIC_API_KEY=

# NOTE: do not put PYTHONIOENCODING here. Python reads it at interpreter
# startup, before any .env loader runs, so it would have no effect. The CLI
# reconfigures stdout to UTF-8 itself (see cli._force_utf8).
